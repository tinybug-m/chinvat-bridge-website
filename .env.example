# Stripe — copy this file to .env.local and fill in real values.
# Use TEST mode keys (sk_test_..., not sk_live_...) until you are ready to accept real payments.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from the 3 subscription Products created in the Stripe Dashboard
# (Product catalog -> Add product -> Recurring price), one per plan in src/data/pricing.ts.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# Supabase — project settings > API in your Supabase dashboard. Used to create client
# accounts automatically after a successful subscription (see src/app/api/webhooks/stripe).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose to the browser (protected by Row Level Security).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — server-only, never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The site's own canonical URL. In production this is used (instead of the request's
# Host header) to build Stripe redirect URLs and Supabase auth email links, so it must
# match the real deployed domain exactly. Not read in development. It is also the canonical origin
# for every <link rel="canonical">, Open Graph URL, structured-data URL, sitemap and robots.txt line.
# Production: https://www.chinvatbridge.com (the .uk domains redirect to it).
NEXT_PUBLIC_SITE_URL=

# Optional: Search Console and Bing Webmaster Tools ownership by HTML meta tag. Only the token
# (the content="..." value), not the whole tag. Leave empty when verifying by DNS, which is the
# recommended route for a Search Console Domain property.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google OAuth client secret — only used by `supabase config push` to configure the
# Google sign-in provider, never read by the Next.js app itself. Get it from Google
# Cloud Console > APIs & Services > Credentials (see supabase/config.toml for the
# matching client_id and the exact redirect URI Google needs authorized).
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Comma-separated emails allowed into /admin — each one must sign in (Google or the
# magic-link form) with this exact address to get admin access.
ADMIN_EMAILS=

# Contact conversation — messages from the homepage are emailed through Gmail / Google Workspace SMTP.
# GMAIL_USER is the account that sends (e.g. artin@chinvatbridge.com). GMAIL_APP_PASSWORD is a
# 16-character App Password for that account (Google Account > Security > 2-Step Verification must be on,
# then "App passwords"); it is not the normal password. Server-only, never expose it to the client.
# ENQUIRY_TO is optional: where messages go (defaults to the site's contact address).
# Without these, `next dev` logs each message to the terminal instead of sending it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ENQUIRY_TO=

# Articles — read from the editorial backend's public API (published articles only), server-side.
# Not NEXT_PUBLIC_: never sent to the browser. The build needs it too: /insights, article pages and
# the sitemap are prerendered from it. Without it, article pages fail rather than render empty.
EDITORIAL_API_URL=
# Shared secret that authenticates publication events sent by the editorial backend to
# /api/editorial/revalidate (HMAC-SHA256, 32+ characters; the backend holds the same value).
EDITORIAL_REVALIDATE_SECRET=
# Draft previews: drafts:read token for the editorial API, and the secret that signs /api/preview links (32+ characters).
# EDITORIAL_PREVIEW_TOKEN=
# PREVIEW_SECRET=
