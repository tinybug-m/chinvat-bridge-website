# Stripe — copy this file to .env.local and fill in real values.
# Use TEST mode keys (sk_test_..., not sk_live_...) until you are ready to accept real payments.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Price IDs from the 3 subscription Products created in the Stripe Dashboard
# (Product catalog -> Add product -> Recurring price), one per plan in src/data/pricing.ts.
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
STRIPE_PRICE_ID_SCALE=

# Supabase — project settings > API in your Supabase dashboard. Used to create client
# accounts automatically after a successful subscription (see src/app/api/webhooks/stripe).
# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose to the browser (protected by Row Level Security).
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely — server-only, never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
